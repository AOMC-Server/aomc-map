# --- Required for login ---------------------------------------------------------
# Create an application at https://discord.com/developers/applications and add the redirect URI
#   <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs the OAuth state cookie. Use a long random string (e.g. `openssl rand -hex 32`, at least
# 16 characters). Required when PUBLIC_URL is https and in Docker (which runs with NODE_ENV=production).
# SESSION_SECRET=
# The address people use to reach the site. Must match exactly (scheme, host, port): it is used for
# the cookie "Secure" flag, the CSRF Origin check, invite links and link previews.
PUBLIC_URL=http://localhost:3000

# --- First-run setup --------------------------------------------------------------
SETUP_MAP_NAME=AOMC
# Comma-separated Discord user ids that become owners of the map the first time they log in.
# Only read on the first boot, when the map is created; use Manage > Members afterwards.
SETUP_OWNER_DISCORD_IDS=

# --- Privacy statement (/privacy) ---------------------------------------------------
# Who is responsible for the personal data the site keeps (the GDPR "controller"), and how people
# reach them for questions, copies of their data or removal. Fill both in before going public.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=

# --- Server ------------------------------------------------------------------------
# With Docker Compose the published port follows this value too.
PORT=3000
# Where db.sqlite and blobs/ live. In Docker this is /data (set by docker-compose.yml).
DATA_DIR=./data

# --- Map -----------------------------------------------------------------------------
# Blocks per tile edge of the map. Fixed when the map is created on first boot.
DEFAULT_TILE_SIZE=512
# Number of zoom-out levels built above the 1:1 tiles (8 = a tile covers 131,072 blocks at 512).
# Like DEFAULT_TILE_SIZE, set it before the first upload and leave it: existing tiles' zoom-out
# levels are not rebuilt when it changes.
MAX_ZOOM=8

# --- Optional paths -------------------------------------------------------------------
# Built web app to serve (default: web/dist in the repository; /app/web/dist in Docker).
# WEB_DIST=
# For `bun run dev:web` only: where the Vite dev server proxies /api, /auth, /blobs and /scalar.
# BACKEND_URL=http://localhost:3000

# --- Limits (all optional) ---------------------------------------------------------
# MAX_UPLOAD_BYTES=209715200
# MAX_IMAGE_DIM=4096
# MAX_FILES_PER_UPLOAD=2000
# Upload requests per user per minute
# UPLOAD_RATE_LIMIT=30
# Hours after uploading that someone may delete their own upload (0 = moderators only)
# SELF_DELETE_WINDOW_HOURS=24
# Link-preview images kept on disk
# PREVIEW_CACHE_MAX=500

# --- In-game mod (optional) ----------------------------------------------------------
# User-Agents that mark an upload as sent by the in-game mod, so it gets its own statistic.
# Comma separated; case, spaces, _ and - are ignored, and * is a wildcard.
# MOD_USER_AGENTS=AOMC Webmapper,AOMC Visited
